# Cloudflare Pages cache policy for the shared brand assets.
#
# Why this file exists: brand.css and motion.js live at stable URLs that never
# change name, so a returning visitor kept getting the previous deploy's copy
# after a release. The page HTML updated, the stylesheet did not, and the new
# markup rendered unstyled. Revalidating on every request costs one conditional
# request and removes that whole class of bug.
#
# Fonts are the opposite case: their contents are immutable for a given file
# name, so they are cached hard.

/brand.css
  Cache-Control: public, max-age=0, must-revalidate

/motion.js
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
